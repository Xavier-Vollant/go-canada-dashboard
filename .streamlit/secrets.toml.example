# Copy this value into Streamlit Community Cloud's Secrets UI.
# Do not commit a real .streamlit/secrets.toml file with private credentials.
GO_CANADA_READ_ONLY = "true"

# Optional: enable password-protected online database editing.
GO_CANADA_ADMIN_PASSWORD = "choose-a-password"
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"
